{
  "name": "@arihant/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "export": "expo export --platform ios --platform android",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "lint": "node ../../scripts/check-native-text.mjs",
